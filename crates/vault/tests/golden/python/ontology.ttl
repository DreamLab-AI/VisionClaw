ngm:3-d-content-generation a owl:Class ;
    rdfs:label "3D Content Generation"@en ;
    rdfs:comment "The computational process of producing three-dimensional digital content through algorithmic and AI-driven methods, encompassing procedural generation, neural rendering, NeRF-based scene synthesis, and GAN-based 3D model creation. Applications span game development, virtual reality, digital twins, and automated CAD, enabling scalable production of photorealistic 3D assets from text or image inputs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:3-d-scene-representation ],
        ngm:generative-ai ;
    vc:bridgesTo ngm:autonomous-robot,
        ngm:extended-reality,
        ngm:metaverse ;
    vc:contrastsWith ngm:3d-modelling,
        ngm:photogrammetry ;
    vc:dependsOn ngm:gpu-compute ;
    vc:enables ngm:digital-asset,
        ngm:digital-twin,
        ngm:game-development,
        ngm:virtual-world ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:mesh-generation,
        ngm:neural-rendering,
        ngm:procedural-generation,
        ngm:texture-synthesis ;
    vc:qualityScore "0.68"^^xsd:float ;
    vc:relatedTo ngm:3-d-animation,
        ngm:3-d-asset ;
    vc:requires ngm:3-d-scene-representation,
        ngm:computer-graphics,
        ngm:deep-learning ;
    vc:slug "3-d-content-generation" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:deep-learning,
        ngm:diffusion-model,
        ngm:generative-adversarial-network,
        ngm:neural-radiance-field,
        ngm:neural-rendering,
        ngm:procedural-generation .

ngm:3-d-reconstruction a owl:Class ;
    rdfs:label "3D Reconstruction"@en ;
    rdfs:comment "3D Reconstruction is the computational process of recovering three-dimensional geometric and structural information from multiple 2D images or sensor data (such as LiDAR or depth cameras) using techniques including Computer Vision, photogrammetry, and Structure-from-Motion (SfM), enabling digital capture of real-world objects and environments for Digital Twin creation, immersive environment mapping, and spatial analysis."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:bridgesTo ngm:computer-vision,
        ngm:machine-learning,
        ngm:robotics ;
    vc:dependsOn ngm:computer-vision,
        ngm:deep-learning ;
    vc:enables ngm:augmented-reality,
        ngm:digital-twin,
        ngm:environmental-mapping,
        ngm:point-cloud-generation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:depth-estimation,
        ngm:multi-view-stereo,
        ngm:point-cloud,
        ngm:structure-from-motion ;
    vc:isPartOf ngm:photogrammetry ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:scene-understanding,
        ngm:spatial-computing ;
    vc:requires ngm:camera-calibration,
        ngm:feature-matching,
        ngm:image-processing,
        ngm:sensor-fusion ;
    vc:slug "3-d-reconstruction" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:lidar,
        ngm:neural-radiance-field,
        ngm:simultaneous-localisation-and-mapping .

ngm:3-d-rendering-engine a owl:Class ;
    rdfs:label "3D Rendering Engine"@en ;
    rdfs:comment "A 3D rendering engine is software that converts three-dimensional geometric data into two-dimensional images through processes including geometry processing, lighting calculation, texture mapping, and rasterisation or ray tracing. In real-time contexts it targets interactive frame rates (90 Hz+) and must minimise motion-to-photon latency for XR presence."@en ;
    rdfs:subClassOf ngm:computer-graphics ;
    vc:bridgesTo ngm:inference,
        ngm:metaverse ;
    vc:contrastsWith ngm:offline-rendering ;
    vc:dependsOn ngm:physics-engine,
        ngm:spatial-audio ;
    vc:enables ngm:digital-twin,
        ngm:foveated-rendering,
        ngm:immersive-experiences,
        ngm:real-time-visualisation,
        ngm:xr-applications ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:level-of-detail,
        ngm:scene-graph,
        ngm:shader-pipeline,
        ngm:texture-mapping ;
    vc:implements ngm:rasterization,
        ngm:ray-tracing ;
    vc:isPartOf ngm:game-engine ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:spatial-computing ;
    vc:requires ngm:graphics-api,
        ngm:graphics-processing-unit ;
    vc:slug "3-d-rendering-engine" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:khronos-group ;
    vc:supports ngm:augmented-reality,
        ngm:stereoscopic-display,
        ngm:virtual-reality ;
    vc:uses ngm:directx,
        ngm:open-gl,
        ngm:vulkan .

