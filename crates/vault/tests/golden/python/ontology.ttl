ngm:3-d-and-4-d a owl:Class ;
    rdfs:label "3D and 4D"@en ;
    rdfs:comment "The domain of three-dimensional and four-dimensional content creation, covering tools, techniques, and AI-powered pipelines for generating, editing, and rendering 3D assets and temporally dynamic (4D) representations. Encompasses text-to-3D systems (NVIDIA Edify, Luma Genie, Point-E), neural radiance fields, Gaussian splatting, and diffusion-based mesh generation, as well as 6D pose estimation, scene-scale generation, and integration with AR/VR workflows."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:3-d-asset,
        ngm:augmented-reality,
        ngm:pose-estimation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:computer-vision,
        ngm:machine-learning-discipline ;
    vc:slug "3-d-and-4-d" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:deep-learning,
        ngm:diffusion-model,
        ngm:generative-ai,
        ngm:neural-radiance-field .

ngm:3-d-asset-standard a owl:Class ;
    rdfs:label "3D Asset Standard"@en ;
    rdfs:comment "A 3D Asset Standard is a formal specification defining the file formats, metadata schemas, coordinate systems, material models, animation encodings, and interoperability protocols required for consistent creation, exchange, and real-time rendering of three-dimensional digital content across diverse software platforms and runtime environments. Such standards normalise vertex data structures, physically based rendering (PBR) material pipelines, level-of-detail hierarchies, skeletal animation rigs, and compression algorithms so that assets created in one authoring tool function correctly in another without manual conversion or data loss. Prominent examples include the Khronos Group glTF 2.0 specification for web and mobile 3D delivery, Pixar's Universal Scene Description (USD/USDZ) for complex scene composition, and the Metaverse Standards Forum interoperability profiles. These specifications underpin spatial computing, extended reality, game engines, digital-twin platforms, and emerging metaverse ecosystems by ensuring deterministic visual fidelity and semantic asset identity across the entire content pipeline."@en ;
    rdfs:subClassOf ngm:interoperability-standard ;
    vc:bridgesTo ngm:non-fungible-token,
        ngm:semantic-web-linked-data-standard ;
    vc:contrastsWith ngm:fbx ;
    vc:enables ngm:asset-interoperability,
        ngm:digital-twin,
        ngm:extended-reality,
        ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:gltf-standard,
        ngm:level-of-detail,
        ngm:physically-based-rendering,
        ngm:universal-scene-description ;
    vc:implements ngm:iso-iec-14496-16,
        ngm:open-standard ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:digital-content-creation,
        ngm:iso-iec-14496-16,
        ngm:spatial-web ;
    vc:requires ngm:coordinate-system,
        ngm:mesh-compression,
        ngm:texture-atlas ;
    vc:slug "3-d-asset-standard" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:academy-software-foundation,
        ngm:khronos-group,
        ngm:metaverse-standards-forum ;
    vc:supports ngm:augmented-reality,
        ngm:game-engine,
        ngm:metaverse-platform ;
    vc:uses ngm:material-x,
        ngm:scene-graph,
        ngm:skeletal-animation .

ngm:3-d-design a owl:Class ;
    rdfs:label "3D Design"@en ;
    rdfs:comment "3D Design is the creative and technical discipline of conceiving, modelling, and refining three-dimensional digital objects and environments for interactive, immersive, or real-time applications. It encompasses spatial composition, form language, and visual hierarchy adapted for game engines, virtual reality, and metaverse platforms, requiring performance-conscious workflows such as level-of-detail strategies, UV unwrapping, and real-time shader design."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:3d-modelling ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:3-d-asset ],
        ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:3-d-content-generation,
        ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:3-d-asset ;
    vc:isPartOf ngm:3-d-content-pipeline,
        ngm:3-d-development ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:3d-modelling,
        ngm:rendering-engine ;
    vc:slug "3-d-design" ;
    vc:sourceDomain "infrastructure" .

ngm:3-d-engine a owl:Class ;
    rdfs:label "3D Engine"@en ;
    rdfs:comment "A 3D engine is software that handles the representation, rendering, physics simulation, and animation of three-dimensional scenes, providing an abstraction layer over GPU hardware and platform-specific graphics APIs so developers can build interactive applications and simulations without writing low-level graphics code."@en ;
    rdfs:subClassOf ngm:game-engine ;
    vc:bridgesTo ngm:machine-learning,
        ngm:robotics ;
    vc:enables ngm:augmented-reality,
        ngm:digital-twin,
        ngm:virtual-reality ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:animation-system,
        ngm:physics-simulation-engine,
        ngm:rendering-pipeline,
        ngm:scene-graph ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:extended-reality,
        ngm:level-of-detail ;
    vc:requires ngm:computational-geometry,
        ngm:graphics-processing-unit,
        ngm:linear-algebra,
        ngm:shader ;
    vc:slug "3-d-engine" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:metaverse,
        ngm:spatial-computing ;
    vc:uses ngm:directx,
        ngm:open-gl,
        ngm:vulkan,
        ngm:webgpu .

ngm:3-d-geometry a owl:Class ;
    rdfs:label "3D Geometry"@en ;
    rdfs:comment "3D geometry is the mathematical description of shapes, positions, and transformations of objects in three-dimensional space, using representations such as points, vectors, meshes, and coordinate transforms. It provides the underlying spatial data model that computer graphics rendering pipelines and photorealistic rendering engines operate on, from vertex positions through to camera projection matrices. Practical 3D geometry combines linear algebra with computational geometry techniques to represent and manipulate scenes efficiently."@en ;
    rdfs:subClassOf ngm:computational-geometry ;
    vc:enables ngm:computer-graphics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "3-d-geometry" ;
    vc:sourceDomain "spatial-computing" .

ngm:3-d-scene-exchange-protocol-sxp a owl:Class ;
    rdfs:label "3D Scene Exchange Protocol (SXP)"@en ;
    rdfs:comment "Open standards framework enabling interoperable transfer of complete 3D scene graphs including geometric meshes (polygon topology vertex positions normals texture coordinates with indexed triangle lists optimized for GPU rendering), physically-based rendering (PBR) material systems (metallic-roug..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:3-d-modeling-software ],
        ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:asset-portability,
        ngm:cross-platform-compatibility,
        ngm:e-commerce-3-d,
        ngm:metaverse-interoperability,
        ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:animation-rig,
        ngm:material-system,
        ngm:normal-map,
        ngm:texture-map,
        ngm:vertex-attribute ;
    vc:implements ngm:non-destructive-editing,
        ngm:pbr-materials,
        ngm:scene-graph-format,
        ngm:skeletal-animation,
        ngm:version-control ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:3-d-modeling-software,
        ngm:game-engine,
        ngm:mesh-compression,
        ngm:rendering-pipeline,
        ngm:texture-authoring ;
    vc:slug "3-d-scene-exchange-protocol-sxp" ;
    vc:sourceDomain "spatial-computing" .

ngm:3-d-user-interface a owl:Class ;
    rdfs:label "3D User Interface"@en ;
    rdfs:comment "A 3D User Interface (3DUI) is an interactive control system within three-dimensional virtual environments enabling users to manipulate objects, navigate spaces, and access functionality through spatial gestures, hand tracking, gaze-based selection, and voice commands. 3DUI design balances accessibility standards with intuitive spatial affordances appropriate for VR, AR, and metaverse interactions."@en ;
    rdfs:subClassOf ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
    vc:bridgesTo ngm:digital-twin,
        ngm:interaction-design,
        ngm:metaverse ;
    vc:contrastsWith ngm:graphical-user-interface,
        ngm:user-interface ;
    vc:enables ngm:immersive-experience,
        ngm:user-navigation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:gaze-tracking,
        ngm:gesture-recognition,
        ngm:hand-tracking,
        ngm:haptic-feedback,
        ngm:voice-input ;
    vc:isPartOf ngm:extended-reality,
        ngm:spatial-computing ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:augmented-reality,
        ngm:embodied-interaction,
        ngm:mixed-reality,
        ngm:virtual-reality ;
    vc:requires ngm:gaze-tracking,
        ngm:hand-tracking,
        ngm:haptic-feedback,
        ngm:sensor-input,
        ngm:voice-input ;
    vc:slug "3-d-user-interface" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:accessibility-standard,
        ngm:multimodal-interaction ;
    vc:uses ngm:depth-sensing,
        ngm:real-time-rendering,
        ngm:spatial-audio .

ngm:360-video a owl:Class ;
    rdfs:label "360 Video"@en ;
    rdfs:comment "A spherical video format captured with omnidirectional camera rigs that records the full 360-degree field of view around a single vantage point, allowing viewers to look in any direction during playback on headsets, browsers, or mobile devices. Because the footage is fixed to the capture position, it offers rotational (three-degrees-of-freedom) immersion but no positional movement, distinguishing it from volumetric formats that reconstruct scene geometry."@en ;
    rdfs:subClassOf ngm:immersive-media ;
    vc:contrastsWith ngm:volumetric-capture,
        ngm:volumetric-video ;
    vc:enables ngm:vr-experiences ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:virtual-reality ;
    vc:slug "360-video" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:video-streaming .

ngm:3d-asset-creation a owl:Class ;
    rdfs:label "3D Asset Creation"@en ;
    rdfs:comment "The production of three-dimensional digital assets—models, characters, environments, props, and their materials, textures, rigs, and animations—ready for use in games, film, extended reality, simulation, and digital-twin applications. 3D asset creation is the spatial specialisation of general asset creation, spanning manual modelling and sculpting, photogrammetry and scanning, procedural generation, and increasingly generative AI pipelines that produce textured meshes from text or image prompts."@en ;
    rdfs:subClassOf ngm:asset-creation ;
    vc:enables ngm:virtual-environment ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:creative-tools,
        ngm:digital-asset ;
    vc:slug "3d-asset-creation" ;
    vc:sourceDomain "metaverse" ;
    vc:uses ngm:3d-modelling,
        ngm:procedural-generation,
        ngm:texture-mapping .

ngm:3d-mapping a owl:Class ;
    rdfs:label "3D Mapping"@en ;
    rdfs:comment "3D mapping is the process of building a spatially coherent three-dimensional representation of an environment from sensor observations, such as camera images, LiDAR scans, or depth data, typically as a robot or capture device moves through the space. It relies on techniques including structure-from-motion and triangulation to recover the geometry of the scene and the trajectory of the sensor simultaneously. 3D mapping outputs, including point clouds, meshes, or occupancy grids, support downstream applications in robotics navigation, spatial computing, and photogrammetry-based 3D reconstruction."@en ;
    rdfs:subClassOf ngm:3-d-reconstruction ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "3d-mapping" ;
    vc:sourceDomain "spatial-computing" .

ngm:3d-parallelism a owl:Class ;
    rdfs:label "3D Parallelism"@en ;
    rdfs:comment "3D parallelism is a distributed training strategy that combines data parallelism, tensor parallelism and pipeline parallelism along three independent axes to train models too large for a single accelerator or single parallelism scheme alone. Each axis partitions a different dimension of the problem: data parallelism splits the batch, tensor parallelism splits individual layers across devices, and pipeline parallelism splits the layer stack across stages. Frameworks such as Megatron-LM and DeepSpeed implement 3D parallelism to scale training to thousands of GPUs."@en ;
    rdfs:subClassOf ngm:distributed-training ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "3d-parallelism" ;
    vc:sourceDomain "machine-learning" .

ngm:51-attack a owl:Class ;
    rdfs:label "51% Attack"@en ;
    rdfs:comment "A 51% Attack is a consensus-layer attack on a Proof-of-Work blockchain in which a single entity or coalition controls more than half of the network's hash rate, enabling double-spending, transaction censorship, and chain reorganisation. The attack exploits the longest-chain rule: the attacker mines a private fork containing fraudulent transactions and, once it exceeds the honest chain in cumulative work, broadcasts it to override confirmed history."@en ;
    rdfs:subClassOf ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:bridgesTo ngm:ai-energy-optimisation,
        ngm:game-theory,
        ngm:network-security ;
    vc:contrastsWith ngm:byzantine-fault-tolerance,
        ngm:proof-of-stake ;
    vc:dependsOn ngm:blockchain,
        ngm:cryptocurrency,
        ngm:mining-hardware ;
    vc:enables ngm:chain-reorganization,
        ngm:double-spending,
        ngm:transaction-censorship ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:blockchain-security ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ethereum-smart-contract-platform-classic,
        ngm:finality,
        ngm:selfish-mining,
        ngm:transaction ;
    vc:requires ngm:hash-rate,
        ngm:mining,
        ngm:mining-pool,
        ngm:proof-of-work ;
    vc:slug "51-attack" ;
    vc:sourceDomain "blockchain" .

ngm:a-b-testing a owl:Class ;
    rdfs:label "A/B Testing"@en ;
    rdfs:comment "A/B testing is a controlled experimentation method that compares two or more variants by randomly assigning subjects to each and measuring a defined outcome metric. By holding all factors constant except the variant under test, it isolates causal effects and supports data-driven decisions with statistical rigour. It is widely used to optimise digital products, content and user experiences."@en ;
    rdfs:subClassOf ngm:data-analytics ;
    vc:contrastsWith ngm:usability-testing ;
    vc:dependsOn ngm:data-visualisation ;
    vc:enables ngm:predictive-personalization ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:data-analytics ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:business-intelligence,
        ngm:monitoring-dashboard,
        ngm:recommendation-system,
        ngm:user-experience ;
    vc:slug "a-b-testing" ;
    vc:sourceDomain "data" ;
    vc:supports ngm:data-science,
        ngm:digital-marketing,
        ngm:optimisation ;
    vc:uses ngm:metrics,
        ngm:statistics .

ngm:a-star-algorithm a owl:Class ;
    rdfs:label "A Star Algorithm"@en ;
    rdfs:comment "The A* algorithm is an informed best-first graph-search method that finds a least-cost path from a start node to a goal node by evaluating each candidate node n with the function f(n) = g(n) + h(n), where g(n) is the exact cost accumulated from the start node to n and h(n) is an admissible heuristic estimating the remaining cost from n to the goal. By always expanding the open-list node with the lowest f-value, A* is guaranteed to find the optimal path when h is admissible (never overestimates) and is also consistent (satisfies the triangle inequality h(n) ≤ c(n,n') + h(n') for every edge (n,n')). A* generalises Dijkstra's algorithm by adding goal-directed heuristic guidance, and subsumes greedy best-first search as the special case g(n)=0. First described by Peter Hart, Nils Nilsson, and Bertram Raphael at the Stanford Research Institute in 1968, A* remains the most widely deployed optimal graph-search algorithm in artificial intelligence, robotics, game development, and logistics."@en ;
    rdfs:subClassOf ngm:graph-search,
        ngm:informed-search,
        ngm:search-algorithm ;
    vc:contrastsWith ngm:dijkstra-algorithm,
        ngm:monte-carlo-tree-search,
        ngm:rrt-algorithm ;
    vc:enables ngm:autonomous-navigation,
        ngm:motion-planning,
        ngm:path-planning,
        ngm:pathfinding,
        ngm:shortest-path ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:admissibility,
        ngm:consistency,
        ngm:cost-function,
        ngm:heuristic-methods,
        ngm:priority-queue ;
    vc:implements ngm:graph-search,
        ngm:heuristic-methods,
        ngm:informed-search ;
    vc:qualityScore "0.9"^^xsd:float ;
    vc:relatedTo ngm:bidirectional-search,
        ngm:d-star,
        ngm:graph-theory,
        ngm:ida-star,
        ngm:jump-point-search,
        ngm:occupancy-grid,
        ngm:optimisation,
        ngm:spatial-computing,
        ngm:theta-star ;
    vc:requires ngm:graph-representation,
        ngm:state-space,
        ngm:weighted-graph ;
    vc:slug "a-star-algorithm" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:game-ai,
        ngm:gps-systems,
        ngm:logistics,
        ngm:network-routing,
        ngm:robotics ;
    vc:uses ngm:cost-function,
        ngm:dynamic-programming,
        ngm:graph-search,
        ngm:priority-queue,
        ngm:weighted-graph .

ngm:a2-a-protocol a owl:Class ;
    rdfs:label "A2A Protocol"@en ;
    rdfs:comment "The Agent-to-Agent (A2A) Protocol is an open communication specification, initially proposed by Google in April 2025 and transferred to the Linux Foundation in June 2025, that defines how autonomous AI agents discover one another, negotiate capabilities, delegate tasks, and exchange results across heterogeneous agent frameworks and cloud environments. It uses HTTP/HTTPS transport with JSON-RPC 2.0 structured messages and Server-Sent Events for streaming, an Agent Card system at a well-known URI for capability advertisement, and enterprise-grade authentication through OAuth 2.0, mTLS, and JWT, enabling cross-vendor agent interoperability without requiring shared infrastructure. A2A complements tool-access protocols such as the Model Context Protocol by standardising the agent-to-agent interaction layer, and reached v1.0 production readiness in 2026 with adoption by over 150 organisations including Microsoft, AWS, Salesforce, SAP, and ServiceNow."@en ;
    rdfs:subClassOf ngm:agent-communication-protocol,
        ngm:agent-to-agent-protocol ;
    vc:bridgesTo ngm:microservices-architecture,
        ngm:peer-to-peer-network,
        ngm:semantic-web,
        ngm:web-of-things ;
    vc:contrastsWith ngm:model-context-protocol,
        ngm:remote-procedure-call ;
    vc:dependsOn ngm:autonomous-agent,
        ngm:distributed-systems,
        ngm:service-discovery ;
    vc:enables ngm:agent-marketplace,
        ngm:agentic-workflow,
        ngm:enterprise-ai,
        ngm:inter-agent-communication,
        ngm:multi-agent-orchestration,
        ngm:task-delegation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:agent-card,
        ngm:capability-negotiation,
        ngm:streaming-api,
        ngm:task-lifecycle ;
    vc:qualityScore "0.88"^^xsd:float ;
    vc:relatedTo ngm:contract-net-protocol,
        ngm:fipa-acl,
        ngm:model-context-protocol,
        ngm:multi-agent-system,
        ngm:prompt-injection ;
    vc:requires ngm:http-protocol,
        ngm:json-data-interchange-format-rpc-2-0,
        ngm:json-data-interchange-format-schema,
        ngm:oauth-2-0,
        ngm:server-sent-events ;
    vc:slug "a2-a-protocol" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:agent-frameworks,
        ngm:agentic-ai,
        ngm:function-calling,
        ngm:json-ld,
        ngm:protocol-buffer .

ngm:aaai a owl:Class ;
    rdfs:label "AAAI"@en ;
    rdfs:comment "AAAI (the Association for the Advancement of Artificial Intelligence), founded in 1979 under the original name 'American Association for Artificial Intelligence' and renamed in 2007, is the principal non-profit scientific society devoted to advancing research in and responsible use of artificial intelligence. It is best known for its flagship annual peer-reviewed conference — one of the most selective and broadly scoped venues in AI — alongside the AI, Ethics and Society (AIES) conference, symposia, workshops, and the journal AI Magazine. AAAI also engages in education, public communication, and policy discussion concerning AI; administers the AAAI Fellows Program recognising sustained contributions to the discipline; and maintains historical continuity as the first professional society dedicated exclusively to AI, founded by leaders including Allen Newell, Edward Feigenbaum, Marvin Minsky, and John McCarthy. AAAI 2026 — the 40th annual conference — received 23,680 submissions and accepted 4,167 papers at a 17.6% acceptance rate, making it the most competitive edition in the conference's history."@en ;
    rdfs:subClassOf ngm:academic-conference,
        ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:bridgesTo ngm:ai-alignment,
        ngm:ai-governance,
        ngm:artificial-intelligence ;
    vc:contrastsWith ngm:cvpr,
        ngm:iclr,
        ngm:icml,
        ngm:ijcai,
        ngm:neur-ips ;
    vc:enables ngm:ai-for-social-good,
        ngm:ai-research,
        ngm:benchmark-standard,
        ngm:research-dissemination ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:aaai-conference,
        ngm:aaai-fellows-program,
        ngm:ai-magazine,
        ngm:peer-review,
        ngm:poster-session,
        ngm:programme-committee,
        ngm:tutorial,
        ngm:workshop ;
    vc:qualityScore "0.9"^^xsd:float ;
    vc:relatedTo ngm:academic-conference,
        ngm:knowledge-representation,
        ngm:multi-agent-system,
        ngm:research-institution,
        ngm:scientific-conference,
        ngm:symbolic-ai ;
    vc:slug "aaai" ;
    vc:sourceDomain "ai" ;
    vc:standardizedBy ngm:double-blind-review,
        ngm:peer-review ;
    vc:supports ngm:ai-ethics,
        ngm:ai-policy,
        ngm:artificial-intelligence,
        ngm:machine-learning,
        ngm:open-science,
        ngm:responsible-ai .

ngm:abi-encoding a owl:Class ;
    rdfs:label "ABI Encoding"@en ;
    rdfs:comment "ABI encoding is the Application Binary Interface encoding scheme used by the Ethereum Virtual Machine to serialise function calls and their arguments into the byte layout that smart contracts expect on-chain. It defines fixed rules for encoding primitive types, dynamic types such as strings and arrays, and nested structures, so that a compiled contract can decode calldata deterministically regardless of the source language or tool that produced it. Development toolchains such as Foundry and compilers such as Vyper generate ABI-encoded calldata automatically from a contract's interface definition."@en ;
    rdfs:subClassOf ngm:smart-contract ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "abi-encoding" ;
    vc:sourceDomain "blockchain" .

ngm:acid-properties a owl:Class ;
    rdfs:label "ACID Properties"@en ;
    rdfs:comment "ACID Properties are the four guarantees - Atomicity, Consistency, Isolation and Durability - that define a reliable database transaction. Atomicity ensures a transaction is all-or-nothing; Consistency preserves invariants; Isolation hides concurrent intermediate states; and Durability persists committed results across failures. Together they let applications reason about correctness despite concurrency and crashes, distinguishing strongly consistent transactional systems from eventually consistent alternatives."@en ;
    rdfs:subClassOf ngm:transaction ;
    vc:contrastsWith ngm:scalability ;
    vc:dependsOn ngm:data-persistence,
        ngm:write-ahead-logging ;
    vc:enables ngm:data-integrity,
        ngm:relational-database,
        ngm:reliability ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:data-integrity,
        ngm:fault-tolerance ;
    vc:implements ngm:data-integrity,
        ngm:reliability ;
    vc:isPartOf ngm:transaction ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:data-persistence,
        ngm:distributed-systems,
        ngm:transaction ;
    vc:requires ngm:two-phase-commit,
        ngm:write-ahead-logging ;
    vc:slug "acid-properties" ;
    vc:sourceDomain "distributed-systems" ;
    vc:supports ngm:database-management-system,
        ngm:database-systems ;
    vc:uses ngm:two-phase-commit .

ngm:acinq a owl:Class ;
    rdfs:label "ACINQ"@en ;
    rdfs:comment "ACINQ is a Paris-based Bitcoin technology company specialising in the development and operation of Lightning Network infrastructure, most notably the Eclair Lightning Network node implementation written in Scala and the Phoenix self-custodial mobile Bitcoin wallet. The company operates one of the largest publicly reachable Lightning Network routing nodes, providing significant liquidity and routing capacity to the network. ACINQ contributes to the BOLT (Basis of Lightning Technology) protocol specification process and has pioneered features such as trampoline routing to reduce the on-device computation required by mobile Lightning clients."@en ;
    rdfs:subClassOf ngm:lightning-network ;
    vc:bridgesTo ngm:decentralised-finance,
        ngm:peer-to-peer-network ;
    vc:contrastsWith ngm:core-lightning,
        ngm:lnd ;
    vc:enables ngm:micropayment,
        ngm:non-custodial-wallet ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:eclair,
        ngm:phoenix-wallet ;
    vc:implements ngm:lightning-network,
        ngm:onion-routing ;
    vc:isPartOf ngm:lightning-network ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-proof-of-work-protocol-layer-2,
        ngm:bolt-12,
        ngm:channel-liquidity ;
    vc:requires ngm:bitcoin,
        ngm:payment-channel ;
    vc:slug "acinq" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:splicing ;
    vc:uses ngm:htlc,
        ngm:onion-routing,
        ngm:programming-language .

ngm:acl a owl:Class ;
    rdfs:label "ACL"@en ;
    rdfs:comment "An Access Control List (ACL) is a data structure attached to a resource — such as a file, directory, or network interface — that enumerates which subjects (users, groups, or processes) are permitted to perform which operations on that resource. Each entry in the list is called an Access Control Entry (ACE) and specifies a principal, a set of permissions (read, write, execute, delete), and whether those permissions are granted or denied. ACLs originated in file-system security (POSIX, NTFS) and were subsequently extended to networking, where routers and firewalls use IP-level ACLs to filter packets by source address, destination port, and protocol. In distributed and cloud environments ACLs underpin fine-grained authorisation that complements role-based and attribute-based access-control models."@en ;
    rdfs:subClassOf ngm:access-control ;
    vc:contrastsWith ngm:policy-enforcement-point ;
    vc:enables ngm:policy-enforcement,
        ngm:zero-trust-architecture ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:access-control-system,
        ngm:digital-identity,
        ngm:identity-and-access-management ;
    vc:slug "acl" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:authentication,
        ngm:encryption .

