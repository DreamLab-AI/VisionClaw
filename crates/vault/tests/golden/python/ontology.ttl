vc:dependsOn a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "dependsOn"@en ;
    rdfs:domain owl:Thing ;
    rdfs:range owl:Thing .

ngm:3-d-content-creation a owl:Class ;
    rdfs:label "3D Content Creation"@en ;
    rdfs:comment "3D Content Creation encompasses the end-to-end process of designing, modelling, texturing, rigging, and rendering three-dimensional digital assets and environments for use in games, film, XR experiences, and digital twins. It spans artistic and technical disciplines ranging from polygon modelling and UV unwrapping to physically based material authoring and real-time rendering optimisation. The discipline bridges human creative intent and the technical pipelines that deliver interactive or cinematic experiences."@en ;
    rdfs:subClassOf ngm:content-creation ;
    vc:enables ngm:3-d-content-pipeline,
        ngm:digital-twin-creation,
        ngm:xr-applications ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:3-d-asset,
        ngm:3-d-generation,
        ngm:motion-capture ;
    vc:slug "3-d-content-creation" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:3-d-modeling-software,
        ngm:3-d-rendering-engine,
        ngm:physically-based-rendering .

ngm:3-d-content-pipeline a owl:Class ;
    rdfs:label "3D Content Pipeline"@en ;
    rdfs:comment "The comprehensive workflows, tools, and methodologies for creating, processing, optimising, and delivering three-dimensional assets for metaverse and spatial computing applications. A 3D content pipeline spans concept art, geometry modelling, UV mapping, PBR texturing, rigging, LOD generation, and platform-specific optimisation, integrating DCC tools, game engines, version control, and CI/CD systems to support distributed teams and continuous asset delivery."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:3-d-asset ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:3-d-animation ],
        ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:bridgesTo ngm:cloud-computing ;
    vc:dependsOn ngm:asset-management-system,
        ngm:ci-cd-automation ;
    vc:enables ngm:metaverse-and-telecollaboration,
        ngm:procedural-generation,
        ngm:real-time-rendering,
        ngm:xr-content-delivery ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:3-d-animation,
        ngm:3-d-asset,
        ngm:character-rigging,
        ngm:level-of-detail,
        ngm:rendering-pipeline ;
    vc:qualityScore "0.73"^^xsd:float ;
    vc:relatedTo ngm:3-d-content-generation,
        ngm:digital-twin ;
    vc:requires ngm:digital-content-creation,
        ngm:game-engine,
        ngm:version-control ;
    vc:slug "3-d-content-pipeline" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:gltf-standard,
        ngm:universal-scene-description ;
    vc:supports ngm:distributed-team-collaboration ;
    vc:uses ngm:geometry-processing,
        ngm:physically-based-rendering .

ngm:3-d-graphics-standard a owl:Class ;
    rdfs:label "3D Graphics Standard"@en ;
    rdfs:comment "3D Graphics Standards are technical specifications and conventions governing the representation, rendering, and interchange of three-dimensional visual data, including APIs like OpenGL, DirectX, and Vulkan, shader languages, and coordinate system conventions."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets,
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-content-and-assets,
        ngm:sc-display-and-rendering ;
    vc:enables ngm:cross-platform-compatibility,
        ngm:hardware-acceleration,
        ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:technical-standard ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:driver-software,
        ngm:gpu ;
    vc:slug "3-d-graphics-standard" ;
    vc:sourceDomain "spatial-computing" .

ngm:3-d-li-dar a owl:Class ;
    rdfs:label "3D LiDAR"@en ;
    rdfs:comment "3D LiDAR is a active ranging sensor that emits pulsed laser light across multiple vertical channels to capture dense three-dimensional point clouds of the surrounding environment. Spinning or solid-state variants measure range and intensity for hundreds of thousands of points per second, enabling robots and autonomous vehicles to perform obstacle detection, SLAM, and high-fidelity scene reconstruction in real time."@en ;
    rdfs:subClassOf ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:bridgesTo ngm:lidar ;
    vc:enables ngm:autonomous-navigation,
        ngm:point-cloud,
        ngm:simultaneous-localisation-and-mapping,
        ngm:slam ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:2-d-li-dar,
        ngm:lidar-scanning,
        ngm:multirotor-uav,
        ngm:stereo-camera ;
    vc:slug "3-d-li-dar" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:perception-system,
        ngm:sensor-fusion .

ngm:3-d-rendering a owl:Class ;
    rdfs:label "3D Rendering"@en ;
    rdfs:comment "3D rendering is the computational process of generating a two-dimensional image or animation from a three-dimensional scene description by simulating the interaction of light with surfaces, materials, and geometry. It encompasses techniques ranging from real-time rasterization used in interactive applications to physically-based ray tracing and path tracing used for photorealistic offline production. The pipeline converts geometric primitives, shader programs, texture maps, and lighting data into final pixel colours via a GPU compute pipeline or software renderer. Contemporary rendering also incorporates neural methods such as Neural Radiance Fields and 3D Gaussian Splatting, as well as AI-driven upscaling and denoising, blurring the boundary between classical computer graphics and machine learning."@en ;
    rdfs:subClassOf ngm:computer-graphics ;
    vc:bridgesTo ngm:3-d-content-generation,
        ngm:3-d-gaussian-splatting,
        ngm:differentiable-rendering,
        ngm:neural-radiance-field ;
    vc:dependsOn ngm:3-d-rendering-engine,
        ngm:linear-algebra ;
    vc:enables ngm:augmented-reality,
        ngm:foveated-rendering,
        ngm:photorealistic-rendering,
        ngm:physically-based-rendering,
        ngm:real-time-graphics,
        ngm:virtual-reality ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:compute-shader,
        ngm:path-tracing,
        ngm:pixel-shader,
        ngm:rasterization,
        ngm:ray-tracing,
        ngm:render-pipeline ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:anti-aliasing,
        ngm:global-illumination,
        ngm:level-of-detail,
        ngm:spatial-computing ;
    vc:requires ngm:depth-buffer,
        ngm:graphics-processing-unit,
        ngm:virtual-lighting-model ;
    vc:slug "3-d-rendering" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:3-d-model,
        ngm:gpu-compute,
        ngm:scene-graph,
        ngm:shader,
        ngm:texture-mapping .

ngm:3-d-scanning a owl:Class ;
    rdfs:label "3D Scanning"@en ;
    rdfs:comment "3D Scanning is the process of capturing the three-dimensional shape, and optionally the colour and texture, of real-world objects, people, or environments using hardware such as structured-light scanners, time-of-flight LiDAR, photogrammetry rigs, or depth cameras, producing digital point clouds or meshes that represent the physical source. The resulting data feeds into digital preservation, reverse engineering, visual-effects production, quality inspection, and spatial computing pipelines. Accuracy, resolution, and scan volume are the primary quality axes that distinguish scanning technologies."@en ;
    rdfs:subClassOf ngm:3-d-reconstruction ;
    vc:bridgesTo ngm:medical-imaging,
        ngm:robotics-perception ;
    vc:contrastsWith ngm:neural-radiance-field,
        ngm:structure-from-motion ;
    vc:enables ngm:3-d-scene-reconstruction,
        ngm:digital-heritage,
        ngm:digital-twin-creation,
        ngm:point-cloud-processing,
        ngm:reverse-engineering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:mesh-generation,
        ngm:point-cloud ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:3-d-perception,
        ngm:gaussian-splatting,
        ngm:simultaneous-localisation-and-mapping ;
    vc:requires ngm:calibration,
        ngm:depth-sensor ;
    vc:slug "3-d-scanning" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:augmented-reality,
        ngm:building-information-modelling,
        ngm:quality-inspection ;
    vc:uses ngm:3-d-li-dar,
        ngm:photogrammetry,
        ngm:structured-light,
        ngm:time-of-flight-sensor .

ngm:3-d-scene-reconstruction a owl:Class ;
    rdfs:label "3D Scene Reconstruction"@en ;
    rdfs:comment "3D Scene Reconstruction is the computational process of recovering a complete, coherent three-dimensional model of an environment or scene from sensor observations such as images, depth maps, or LiDAR returns, integrating multiple viewpoints and modalities into a unified representation. Methods include volumetric fusion, truncated signed distance function (TSDF) integration, neural implicit representations, and Gaussian splatting, each offering different trade-offs between completeness, accuracy, and real-time capability. The output is used in robotics, autonomous driving, spatial computing, and cultural heritage documentation."@en ;
    rdfs:subClassOf ngm:3-d-reconstruction ;
    vc:enables ngm:3-d-perception,
        ngm:ar-registration,
        ngm:digital-twin-creation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:3-d-scanning,
        ngm:gaussian-splatting,
        ngm:ne-rf ;
    vc:slug "3-d-scene-reconstruction" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:multi-view-stereo,
        ngm:simultaneous-localisation-and-mapping,
        ngm:structure-from-motion .

ngm:3-d-scene-representation a owl:Class ;
    rdfs:label "3D Scene Representation"@en ;
    rdfs:comment "A 3D scene representation is a data structure that encodes the geometry, appearance and spatial layout of a three-dimensional environment, such as point clouds, meshes, voxel grids or neural implicit fields. It underpins 3D content generation and reconstruction pipelines, providing the intermediate format from which renderable or editable scenes are produced. Point clouds are one common instance, forming a sparse, unstructured representation that is often converted into denser structures for downstream use."@en ;
    rdfs:subClassOf ngm:scene-representation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:point-cloud ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "3-d-scene-representation" ;
    vc:sourceDomain "spatial-computing" .

