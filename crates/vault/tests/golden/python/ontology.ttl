ngm:3-d-animation a owl:Class ;
    rdfs:label "3D Animation"@en ;
    rdfs:comment "3D Animation is the discipline of creating motion in three-dimensional digital environments using techniques such as keyframe animation, motion capture, and procedural simulation. It underpins character movement, environmental dynamics, and cinematic sequences in spatial computing platforms, game engines, and metaverse applications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:3-d-asset ],
        ngm:animation-technique ;
    vc:bridgesTo ngm:generative-ai,
        ngm:machine-learning ;
    vc:contrastsWith ngm:animation ;
    vc:dependsOn ngm:graphics-processing-unit,
        ngm:scene-graph ;
    vc:enables ngm:avatar,
        ngm:digital-twin,
        ngm:immersive-experience ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:animation-state-machine,
        ngm:blend-shape,
        ngm:character-rigging,
        ngm:keyframe-animation ;
    vc:isPartOf ngm:sc-content-and-assets,
        ngm:visual-effects ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:level-of-detail,
        ngm:rendering-pipeline ;
    vc:requires ngm:3-d-asset,
        ngm:game-engine ;
    vc:slug "3-d-animation" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:gltf-standard,
        ngm:iso-iec-jtc-1-sc-24,
        ngm:universal-scene-description ;
    vc:supports ngm:extended-reality,
        ngm:real-time-rendering ;
    vc:uses ngm:inverse-kinematics,
        ngm:motion-capture,
        ngm:physics-simulation,
        ngm:procedural-animation .

ngm:3-d-development a owl:Class ;
    rdfs:label "3D Development"@en ;
    rdfs:comment "3D Development encompasses the modologies, tools, and workflows for creating, iterating, and deploying three-dimensional digital assets and environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:3-d-rendering-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:3-d-graphics-standard ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:bridgesTo ngm:software-development ;
    vc:enables ngm:metaverse-content-creation,
        ngm:virtual-environment-design,
        ngm:xr-applications ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:3-d-graphics-standard,
        ngm:3-d-rendering-engine ;
    vc:slug "3-d-development" ;
    vc:sourceDomain "spatial-computing" .

ngm:3-d-file-format a owl:Class ;
    rdfs:label "3D File Format"@en ;
    rdfs:comment "3D File Formats are standardised container structures for encoding three-dimensional geometric data, textures, materials, animations, and metadata, enabling asset portability across tools, rendering engines, and platforms."@en ;
    rdfs:subClassOf ngm:data-format-standard ;
    vc:bridgesTo ngm:data-format-standard,
        ngm:interoperability,
        ngm:metaverse-infrastructure ;
    vc:enables ngm:3-d-rendering,
        ngm:augmented-reality,
        ngm:cross-platform-asset-exchange,
        ngm:digital-asset-management,
        ngm:real-time-graphics ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:material-definition,
        ngm:mesh-data,
        ngm:texture-map ;
    vc:implements ngm:gl-tf,
        ngm:universal-scene-description ;
    vc:isPartOf ngm:asset-pipeline ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:3-d-model,
        ngm:point-cloud ;
    vc:requires ngm:coordinate-system ;
    vc:slug "3-d-file-format" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:khronos-group,
        ngm:pixar-animation-studios ;
    vc:supports ngm:level-of-detail,
        ngm:physics-simulation ;
    vc:uses ngm:binary-encoding,
        ngm:data-compression .

ngm:3-d-model a owl:Class ;
    rdfs:label "3D Model"@en ;
    rdfs:comment "A 3D Model is a digital representation of a three-dimensional object or environment constructed from vertices, edges, faces, and materials, encoded in standard formats such as glTF, OBJ, FBX, or USD, and used as a foundational asset in spatial computing, simulation, gaming, and metaverse applications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:3-d-file-format ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:3d-modelling ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:bridgesTo ngm:3-d-development,
        ngm:computer-vision ;
    vc:enables ngm:3-d-rendering,
        ngm:animation-retargeting,
        ngm:augmented-reality,
        ngm:interactive-visualization,
        ngm:virtual-reality ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:material-definition,
        ngm:mesh-data,
        ngm:skeletal-rig,
        ngm:texture-mapping ;
    vc:isPartOf ngm:digital-asset,
        ngm:virtual-environment-design ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:photogrammetry,
        ngm:procedural-generation ;
    vc:requires ngm:3-d-file-format,
        ngm:3d-modelling ;
    vc:slug "3-d-model" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:gltf-standard,
        ngm:universal-scene-description ;
    vc:supports ngm:digital-twin,
        ngm:metaverse ;
    vc:uses ngm:level-of-detail,
        ngm:uv-mapping .

ngm:3-d-modeling-software a owl:Class ;
    rdfs:label "3D Modeling Software"@en ;
    rdfs:comment "3D Modeling Software is a category of applications that provide tools for constructing, editing, and organising three-dimensional geometric representations of objects and scenes, typically via polygon mesh editing, subdivision surfaces, NURBS curves, sculpting, or parametric operations. These applications underpin virtually all digital content creation workflows for games, film, architecture, product design, and XR environments. They commonly integrate texturing, rigging, animation, and basic rendering capabilities alongside the core modelling toolkit."@en ;
    rdfs:subClassOf ngm:3d-modelling ;
    vc:enables ngm:3-d-asset,
        ngm:3-d-content-creation,
        ngm:animation-rig ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:bim-software,
        ngm:cad-software,
        ngm:game-engine ;
    vc:slug "3-d-modeling-software" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:3-d-file-format,
        ngm:physically-based-rendering,
        ngm:shader .

ngm:3-d-perception a owl:Class ;
    rdfs:label "3D Perception"@en ;
    rdfs:comment "3D Perception is the computational capability to interpret sensor data — from cameras, LiDAR, radar, and depth sensors — and derive accurate three-dimensional understanding of the surrounding environment, including object detection, pose estimation, scene structure, and semantic labelling. It forms a foundational layer for autonomous systems, robotic manipulation, augmented reality registration, and spatial computing. The discipline draws on computer vision, geometry, and deep learning to transform raw observations into actionable 3D representations."@en ;
    rdfs:subClassOf ngm:computer-vision ;
    vc:enables ngm:6-do-f-tracking,
        ngm:object-detection,
        ngm:simultaneous-localisation-and-mapping ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:3-d-scanning,
        ngm:pose-estimation,
        ngm:semantic-segmentation ;
    vc:slug "3-d-perception" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:depth-sensing,
        ngm:point-cloud,
        ngm:sensor-fusion .

ngm:3-gpp a owl:Class ;
    rdfs:label "3GPP"@en ;
    rdfs:comment "The 3rd Generation Partnership Project (3GPP) is a global consortium of regional telecommunications standards bodies that develops and maintains versioned technical specifications governing mobile communication systems, from UMTS (3G) through LTE (4G) to NR (5G) and the emerging 6G framework. Operating through working groups (RAN, SA, CT), it produces Releases that introduce new radio access technologies, core network architectures, and service-layer capabilities. 3GPP specifications are the foundational technical substrate for the global cellular infrastructure serving billions of devices."@en ;
    rdfs:subClassOf ngm:standards-body ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:digital-twin,
        ngm:spatial-computing ;
    vc:enables ngm:internet-of-things,
        ngm:multi-access-edge-computing,
        ngm:network-function-virtualization,
        ngm:network-slicing,
        ngm:vehicle-to-everything ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:5g-core-network,
        ngm:5g-new-radio,
        ngm:radio-access-network ;
    vc:implements ngm:5-g-connectivity,
        ngm:5-g-network ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:etsi,
        ngm:ieee,
        ngm:itu-r,
        ngm:network-architecture,
        ngm:telecommunications ;
    vc:requires ngm:spectrum-allocation ;
    vc:slug "3-gpp" ;
    vc:sourceDomain "standards" ;
    vc:supports ngm:low-latency .

ngm:5-g a owl:Class ;
    rdfs:label "5G"@en ;
    rdfs:comment "5G (Fifth Generation) is the latest generation of mobile cellular network technology, standardised by 3GPP from Release 15 onwards, characterised by peak data rates exceeding 20 Gbps, radio latencies below 1 ms, and support for up to one million connected devices per square kilometre. It introduces three primary use-case families: enhanced mobile broadband (eMBB), ultra-reliable low-latency communications (URLLC), and massive machine-type communications (mMTC). 5G underpins advances in spatial computing, autonomous vehicles, industrial automation, and IoT at scale."@en ;
    rdfs:subClassOf ngm:telecommunications ;
    vc:bridgesTo ngm:digital-twin,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:4g-lte,
        ngm:6g ;
    vc:enables ngm:5-g-connectivity,
        ngm:autonomous-vehicle,
        ngm:industrial-io-t,
        ngm:multi-access-edge-computing,
        ngm:network-slicing,
        ngm:private-5g-network,
        ngm:xr-applications ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:5g-core,
        ngm:5g-new-radio,
        ngm:service-oriented-architecture ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:5-g-network,
        ngm:internet-of-things,
        ngm:mobile-edge-computing ;
    vc:requires ngm:massive-mimo ;
    vc:slug "5-g" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:3-gpp,
        ngm:itu-r ;
    vc:uses ngm:beamforming,
        ngm:cloud-native,
        ngm:network-function-virtualization .

ngm:5-g-connectivity a owl:Class ;
    rdfs:label "5G Connectivity"@en ;
    rdfs:comment "5G Connectivity is the set of radio access and core network capabilities delivered by a 5G NR network that provides devices and applications with wireless communication services characterised by high throughput, ultra-low latency, and high device density. It encompasses the radio link between user equipment and the gNB base station, quality-of-service mechanisms, network slicing for application-specific service guarantees, and the APIs through which applications access network capabilities. 5G Connectivity is a critical enabler for cloud XR, autonomous systems, and real-time industrial applications."@en ;
    rdfs:subClassOf ngm:5-g ;
    vc:enables ngm:io-t-infrastructure,
        ngm:low-latency,
        ngm:xr-applications ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:3-gpp,
        ngm:guaranteed-bandwidth,
        ngm:latency ;
    vc:slug "5-g-connectivity" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:5-g-network,
        ngm:multi-access-edge-computing,
        ngm:network-function-virtualization .

ngm:5-g-network a owl:Class ;
    rdfs:label "5G Network"@en ;
    rdfs:comment "A 5G Network is the end-to-end fifth-generation mobile telecommunications system comprising a 5G New Radio (NR) radio access network built around gNB base stations, a cloud-native 5G Core implementing a service-based architecture with independently deployable network functions (AMF, SMF, UPF, PCF, NRF, AUSF), and the transport infrastructure interconnecting them. The architecture fundamentally separates the control plane from the user plane, enables network slicing to provision multiple virtualised logical networks on shared physical resources, and integrates multi-access edge computing nodes for deterministic low-latency application hosting. Defined across 3GPP Release 15 (frozen 2018) through Release 18 (5G-Advanced), 5G networks support three canonical service classes: enhanced Mobile Broadband (eMBB), Ultra-Reliable Low-Latency Communications (URLLC), and massive Machine-Type Communications (mMTC), making them the foundational connectivity layer for industrial IoT, autonomous systems, extended reality, and private campus networks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:5-g ],
        ngm:telecommunications-infrastructure ;
    vc:bridgesTo ngm:6-g-network-slice,
        ngm:artificial-intelligence-operations,
        ngm:digital-twin ;
    vc:contrastsWith ngm:wi-fi ;
    vc:enables ngm:5-g-connectivity,
        ngm:autonomous-vehicle,
        ngm:extended-reality,
        ngm:io-t-infrastructure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:5-g,
        ngm:multi-access-edge-computing,
        ngm:network-slicing ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:mobile-edge-computing,
        ngm:network-infrastructure,
        ngm:open-ran ;
    vc:requires ngm:cloud-native-architecture,
        ngm:spectrum-allocation,
        ngm:transport-network ;
    vc:slug "5-g-network" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:3-gpp,
        ngm:etsi,
        ngm:o-ran-alliance ;
    vc:uses ngm:edge-computing,
        ngm:massive-mimo,
        ngm:network-function-virtualization,
        ngm:software-defined-networking .

