ngm:1-hive a owl:Class ;
    rdfs:label "1Hive"@en ;
    rdfs:comment "A decentralised community and DAO that issues the Honey community currency and develops governance tooling such as the Gardens framework for conviction voting."@en ;
    rdfs:subClassOf ngm:decentralized-autonomous-organization ;
    vc:enables ngm:quadratic-funding ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:decentralized-autonomous-organization,
