ngm:3d-modelling a owl:Class ;
    rdfs:label "3D Modelling"@en ;
    rdfs:comment "3D modelling is the creation of a mathematical representation of a three-dimensional surface or volume using specialised software. Models are commonly built from polygon meshes, parametric surfaces or volumetric data and define the geometry that is later textured, rigged, animated and rendered. It is the foundational discipline for games, film, visualisation, product design and spatial computing."@en ;
    rdfs:subClassOf ngm:3-d-development,
        ngm:computer-graphics ;
    vc:bridgesTo ngm:augmented-reality,
        ngm:computer-vision,
        ngm:generative-ai,
        ngm:photogrammetry ;
    vc:contrastsWith ngm:computer-aided-design,
        ngm:digital-art ;
    vc:enables ngm:asset-creation,
        ngm:character-animation,
        ngm:character-model,
        ngm:real-time-graphics,
        ngm:rendering,
        ngm:texture-mapping,
        ngm:virtual-environment-design ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:character-rigging,
        ngm:geometry-processing,
        ngm:material-definition,
        ngm:polygon-mesh,
        ngm:topology ;
    vc:isPartOf ngm:asset-pipeline ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:character-rigging,
        ngm:fbx,
        ngm:skinning,
        ngm:visual-effects ;
    vc:requires ngm:design-software,
        ngm:polygon-mesh ;
    vc:slug "3d-modelling" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:gltf-standard,
        ngm:obj-format ;
    vc:supports ngm:augmented-reality,
        ngm:game-development,
        ngm:game-engine,
        ngm:virtual-production,
        ngm:virtual-reality,
        ngm:visual-effects ;
    vc:uses ngm:3-d-model,
        ngm:computer-aided-design,
        ngm:level-of-detail,
        ngm:uv-mapping .

