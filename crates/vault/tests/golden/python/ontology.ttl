    vc:slug "1-hive" ;
    vc:sourceDomain "governance" .

ngm:1-inch a owl:Class ;
    rdfs:label "1inch"@en ;
    rdfs:comment "A decentralised exchange aggregator that routes trades across multiple liquidity sources to find favourable execution prices on Ethereum and other chains."@en ;
    rdfs:subClassOf ngm:decentralized-exchange ;
    vc:enables ngm:liquidity-pool ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
