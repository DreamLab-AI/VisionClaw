ngm:6-do-f-tracking a owl:Class ;
    rdfs:label "6DoF Tracking"@en ;
    rdfs:comment "6DoF (Six Degrees of Freedom) Tracking is the measurement and continuous estimation of an object's complete rigid-body pose in three-dimensional space, encompassing three translational components (x, y, z position) and three rotational components (pitch, yaw, roll orientation). It is the foundational capability for XR headsets, controllers, and spatial computing devices to understand and respond to the user's physical motion with sub-millimetre accuracy and minimal latency. 6DoF tracking is achieved through sensor fusion of inertial measurement units, camera-based visual odometry, and optionally external beacons or reference markers."@en ;
    rdfs:subClassOf ngm:simultaneous-localisation-and-mapping ;
    vc:enables ngm:3-d-perception,
        ngm:ar-registration,
        ngm:xr-applications ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:camera-tracking,
        ngm:depth-sensing,
        ngm:pose-estimation ;
    vc:slug "6-do-f-tracking" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:imu,
        ngm:sensor-fusion,
        ngm:simultaneous-localisation-and-mapping .

ngm:6-g-network-slice a owl:Class ;
    rdfs:label "6G Network Slice"@en ;
    rdfs:comment "Virtual partition of 6G infrastructure guaranteeing specified quality-of-service levels for immersive workloads through isolated resource allocation."@en ;
    rdfs:subClassOf ngm:infra-network-and-comms ;
    skos:broader ngm:infra-network-and-comms ;
    vc:enables ngm:guaranteed-bandwidth,
        ngm:resource-allocation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:resource-allocation,
        ngm:service-level-agreement ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:network-infrastructure ;
    vc:slug "6-g-network-slice" ;
    vc:sourceDomain "infrastructure" .

