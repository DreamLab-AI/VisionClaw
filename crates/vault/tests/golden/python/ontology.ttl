ngm:2-d-li-dar a owl:Class ;
    rdfs:label "2D LiDAR"@en ;
    rdfs:comment "2D LiDAR is a laser scanning sensor that emits a rotating beam in a single horizontal or vertical plane, producing a planar point cloud used for obstacle detection, proximity sensing, and 2D mapping. It is widely deployed on mobile robots and autonomous guided vehicles where full 3D sensing is unnecessary or cost-prohibitive."@en ;
    rdfs:subClassOf ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:bridgesTo ngm:lidar ;
    vc:enables ngm:localisation,
        ngm:proximity-detection,
        ngm:simultaneous-localisation-and-mapping ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:robo-perception ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:3-d-li-dar,
        ngm:laser-scanner,
        ngm:point-cloud,
        ngm:proximity-sensor,
        ngm:slam,
        ngm:ultrasonic-sensor ;
    vc:slug "2-d-li-dar" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:lidar-scanning .

ngm:3-d-gaussian-splatting a owl:Class ;
    rdfs:label "3D Gaussian Splatting"@en ;
    rdfs:comment "A neural rendering technique that represents 3D scenes as collections of millions of 3D Gaussian primitives with learnable positions, colours, opacities, and covariances, enabling photorealistic real-time rendering at 100+ frames per second through GPU-accelerated rasterisation, revolutionising telepresence and immersive collaboration with unprecedented visual fidelity."@en ;
    rdfs:subClassOf ngm:neural-rendering ;
    vc:bridgesTo ngm:extended-reality,
        ngm:tele-050-neural-rendering-telepresence,
        ngm:web-xr ;
    vc:contrastsWith ngm:neural-radiance-fields,
        ngm:tele-060-instant-ngp ;
    vc:dependsOn ngm:adam-optimiser,
        ngm:multi-view-photography,
        ngm:point-cloud ;
    vc:enables ngm:avatar,
        ngm:novel-view-synthesis,
        ngm:photorealistic-telepresence,
        ngm:tele-053-volumetric-video-conferencing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:gaussian-primitive,
        ngm:spherical-harmonics ;
    vc:implements ngm:alpha-blending ;
    vc:isPartOf ngm:novel-view-synthesis ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:3-d-scene-reconstruction,
        ngm:virtual-reality-telepresence ;
    vc:requires ngm:differentiable-rendering,
        ngm:structure-from-motion ;
    vc:slug "3-d-gaussian-splatting" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:ssim-loss,
        ngm:stochastic-gradient-descent .

ngm:3-d-generation a owl:Class ;
    rdfs:label "3D Generation"@en ;
    rdfs:comment "3D Generation refers to the automated or semi-automated creation of three-dimensional geometry, appearance, and scene representations using machine learning models, procedural algorithms, or hybrid approaches. Techniques include text-to-3D, image-to-3D, and scene-level generation via neural radiance fields, Gaussian splatting, diffusion models, and large multi-modal networks. The field aims to dramatically reduce the time and skill threshold required to produce photorealistic or stylised 3D content for gaming, film, spatial computing, e-commerce, digital twins, and robotics simulation."@en ;
    rdfs:subClassOf ngm:3-d-content-generation,
        ngm:computer-vision,
        ngm:generative-model ;
    vc:enables ngm:3-d-content-creation,
        ngm:digital-twin-generation,
        ngm:game-asset-generation,
        ngm:scene-generation,
        ngm:spatial-computing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:mesh-generation,
        ngm:neural-3-d-generation,
        ngm:novel-view-synthesis,
        ngm:text-to-3-d ;
    vc:qualityScore "0.88"^^xsd:float ;
    vc:relatedTo ngm:3-d-reconstruction,
        ngm:digital-twin,
        ngm:extended-reality,
        ngm:image-generation,
        ngm:robotics ;
    vc:requires ngm:differentiable-rendering,
        ngm:gpu-compute,
        ngm:objaverse ;
    vc:slug "3-d-generation" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:clip,
        ngm:diffusion-model,
        ngm:gaussian-splatting,
        ngm:implicit-neural-representation,
        ngm:ne-rf,
        ngm:score-distillation-sampling,
        ngm:triplane .

