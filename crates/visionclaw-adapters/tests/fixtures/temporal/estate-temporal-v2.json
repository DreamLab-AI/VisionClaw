    {"id": "v4", "subject": "urn:ngm:class:drone", "predicate": "http://www.w3.org/2000/01/rdf-schema#subClassOf", "object": "urn:ngm:class:aircraft", "validFrom": "2026-04-01T00:00:00Z", "generatedAt": "2026-04-01T00:00:00Z"},
