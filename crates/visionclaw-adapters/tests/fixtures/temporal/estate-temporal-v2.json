    {"id": "v16", "subject": "urn:ngm:class:rangefinder", "predicate": "http://www.w3.org/2000/01/rdf-schema#subClassOf", "object": "urn:ngm:class:sensor", "validFrom": "2031-01-01T00:00:00Z", "generatedAt": "2031-06-01T00:00:00Z"},
