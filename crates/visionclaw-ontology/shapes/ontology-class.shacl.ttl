@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix vc:    <https://narrativegoldmine.com/ns/v1#> .
@prefix vcsh:  <urn:ngm:shape:> .

vcsh:OntologyClassShape
    a sh:NodeShape ;
    sh:targetClass owl:Class ;
    sh:name "OntologyClass shape" ;
    sh:description "Every owl:Class must have rdfs:label and rdfs:subClassOf (except root)." ;

    # Labels are language-tagged (`"1Hive"@en`), which W3C SHACL types as
    # rdf:langString, not xsd:string: a datatype constraint of xsd:string fails
    # every class in the published corpus (ADR-2147). A label must be a literal
    # of either kind, never an IRI or a blank node.
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:nodeKind sh:Literal ;
        sh:severity sh:Violation ;
        sh:message "OntologyClass must have at least one rdfs:label literal." ;
    ] ;

    sh:property [
        sh:path vc:domain ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
        sh:message "OntologyClass should declare a vc:domain." ;
    ] .
