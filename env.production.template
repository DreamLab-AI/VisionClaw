# ===========================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ===========================================
# This template contains production-optimized settings with security hardening.
# Copy this file to .env.prod for production deployment:
# cp env.production.template .env.prod && chmod 600 .env.prod
#
# CRITICAL SECURITY:
# - Generate strong, unique secrets for ALL security-related variables
# - Never use default/example values in production
# - Store sensitive values in secure secret management (e.g., AWS Secrets Manager, Vault)
# - Rotate secrets regularly
# - Use environment variables or secure secret injection in production
# ===========================================

# ===========================================
# Environment Type
# ===========================================
NODE_ENV=production
BUILD_TARGET=production
DOCKER_ENV=production
VITE_PUBLIC_DEMO=false
# Pre-demo security fix #1 (audit 2026-08-21): set to "read-only" for the
# public junkiejarvis.com demo so the backend rejects every mutating /api
# request with 403. Leave unset/empty for a normal authenticated deployment.
PUBLIC_DEMO=

# ===========================================
# Ingress (ADR-2119) — declare how clients reach this host
# ===========================================
# tunnel  Cloudflare tunnel. Requires CLOUDFLARE_TUNNEL_TOKEN; launch.sh starts
#         cloudflared. This is also what an undeclared VISIONCLAW_INGRESS means.
# lan     LAN only (e.g. the Trust residential). No token, cloudflared never
#         starts. Requires an explicit CORS_ALLOWED_ORIGINS for this host, e.g.
#         http://<host>:3001; headsets use XR_BACKEND_WS=ws://<host>:3001.
# CLOUDFLARE_TUNNEL_TOKEN and CORS_ALLOWED_ORIGINS are set further down.
VISIONCLAW_INGRESS=

# ===========================================
# GPU / CUDA Configuration (Production)
# ===========================================
# GPU features - configure based on your production hardware
# Uncomment to disable GPU if not available
# NO_GPU_COMPUTE=true

# NVIDIA_VISIBLE_DEVICES: Production GPU configuration
# - Use specific GPU UUID for deterministic behavior
# - Find GPU UUID with: nvidia-smi -L
# REQUIRED if using GPU features
NVIDIA_VISIBLE_DEVICES=GPU-XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX

# CUDA_DEVICE: GPU index inside the container
# OPTIONAL - defaults to 0
CUDA_DEVICE=0

# CUDA_ARCH: CUDA compute capability
# - 86 for RTX 30-series (Ampere) and RTX A6000
# - 89 for RTX 40-series (Ada)
# REQUIRED if using GPU features
CUDA_ARCH=86

# ===========================================
# GitHub Configuration (Production)
# ===========================================
# REQUIRED: Production GitHub repository
GITHUB_OWNER=your-production-github-org
GITHUB_REPO=your-production-repo

# CRITICAL SECURITY: GitHub Personal Access Token
# - Use GitHub Actions secrets or secure secret management
# - Minimum scopes: repo (read/write)
# - Rotate token every 90 days
# REQUIRED
GITHUB_TOKEN=

# OPTIONAL: Repository base path
GITHUB_BASE_PATH=mainKnowledgeGraph/pages

# ===========================================
# RAGFlow Configuration (Production)
# ===========================================
# CRITICAL SECURITY: Production RAGFlow credentials
# - Use secure secret management
# - Rotate API keys regularly
# REQUIRED
RAGFLOW_API_KEY=
RAGFLOW_API_BASE_URL=https://ragflow.yourdomain.com
RAGFLOW_AGENT_ID=

# ===========================================
# Perplexity API Configuration (Production)
# ===========================================
# CRITICAL SECURITY: Production API key
# - Store in secure secret management
# - Monitor usage and costs
# OPTIONAL
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=llama-3.1-sonar-small-128k-online
PERPLEXITY_MAX_TOKENS=4096
PERPLEXITY_TEMPERATURE=0.5
PERPLEXITY_TOP_P=0.9
PERPLEXITY_PRESENCE_PENALTY=0.0
PERPLEXITY_FREQUENCY_PENALTY=1.0
PERPLEXITY_API_URL=https://api.perplexity.ai/chat/completions

# ===========================================
# OpenAI Configuration (Production)
# ===========================================
# CRITICAL SECURITY: Production OpenAI API key
# - Use secure secret management
# - Monitor usage and implement cost controls
# OPTIONAL
OPENAI_API_KEY=
OPENAI_BASE_URL=wss://api.openai.com/v1/realtime
OPENAI_TIMEOUT=30
OPENAI_RATE_LIMIT=100

# ===========================================
# API Client Configuration (Production)
# ===========================================
# Optimized for production reliability
MAX_CONCURRENT_REQUESTS=2
MAX_RETRIES=3
RETRY_DELAY=5
API_CLIENT_TIMEOUT=30

# ===========================================
# Data Paths (Production)
# ===========================================
# Production data persistence paths
DATA_ROOT=/app/data
MARKDOWN_DIR=/app/data/markdown
METADATA_DIR=/app/data/metadata

# ===========================================
# Server Configuration (Production)
# ===========================================
# REQUIRED: Bind to all interfaces for container networking
BIND_ADDRESS=0.0.0.0

# REQUIRED: Disable debug mode in production
DEBUG_ENABLED=false
DEBUG_MODE=false

# REQUIRED: Production-level logging (info/warn/error only)
RUST_LOG=info,visionflow-server::config=info,visionflow-server::models::user_settings=warn,visionflow-server::actors=info,visionflow-server::handlers=info,visionflow-server::telemetry=info,visionflow-server::mcp=info,visionflow-server::docker_exec=warn,visionflow-server::agent_control=info

# REQUIRED: Production settings file
SETTINGS_FILE_PATH=/app/settings.yaml

# ===========================================
# Cloudflare Tunnel Configuration (Production)
# ===========================================
# CRITICAL SECURITY: Production tunnel credentials
# - Use Cloudflare Zero Trust for access control
# - Rotate credentials every 90 days
# REQUIRED when VISIONCLAW_INGRESS=tunnel (or undeclared); unused and may stay
# empty when VISIONCLAW_INGRESS=lan (ADR-2119)
CLOUDFLARE_TUNNEL_TOKEN=
TUNNEL_ID=

# ===========================================
# Network Configuration (Production)
# ===========================================
# REQUIRED: Production domain
DOMAIN=junkiejarvis.com
PUBLIC_HOSTNAME=junkiejarvis.com

# OPTIONAL: Docker registry mirror for faster pulls
DOCKER_REGISTRY_MIRROR=registry-1.docker.io

# ===========================================
# Authentication Configuration (Production)
# ===========================================
# CRITICAL SECURITY: Nostr-based access control
# - Verify all public keys before adding
# - Audit access regularly
# - Remove inactive keys
# REQUIRED: Base access control (comma-separated Nostr public keys)
APPROVED_PUBKEYS=

# Role-based access control
POWER_USER_PUBKEYS=
SETTINGS_SYNC_ENABLED_PUBKEYS=

# Feature-specific access control
PERPLEXITY_ENABLED_PUBKEYS=
OPENAI_ENABLED_PUBKEYS=
RAGFLOW_ENABLED_PUBKEYS=

# ===========================================
# Claude Flow MCP Configuration (Production)
# ===========================================
# REQUIRED: Production MCP server
CLAUDE_FLOW_HOST=agentic-workstation
MCP_TCP_PORT=9500
MCP_TRANSPORT=tcp
MCP_RECONNECT_ATTEMPTS=3
MCP_RECONNECT_DELAY=1000

# CRITICAL SECURITY: Management API credentials
# - Generate strong random key (minimum 64 characters)
# - Rotate every 90 days
# REQUIRED
MANAGEMENT_API_URL=http://agentic-workstation:9090
MANAGEMENT_API_KEY=

# REQUIRED: independent random secrets (minimum 64 characters each)
VISIONCLAW_AGENT_KEY=
SOLID_PROXY_SECRET_KEY=
MCP_CONNECTION_TIMEOUT=30000

# ===========================================
# MCP Communication Logging (Production)
# ===========================================
# Minimal logging for production performance
MCP_LOG_LEVEL=info
MCP_TCP_DEBUG=false
MCP_CONNECTION_LOGGING=true
MCP_TOOL_CALL_LOGGING=false
MCP_RESPONSE_LOGGING=false
MCP_PROTOCOL_TRACE=false

# ===========================================
# Docker Exec Control Plane Logging (Production)
# ===========================================
# Essential logging only
DOCKER_EXEC_LOGGING=true
DOCKER_EXEC_TRACE=false
DOCKER_COMMAND_DEBUG=false
DOCKER_HIVE_MIND_OPERATIONS=true
DOCKER_PROCESS_LIFECYCLE=true

# ===========================================
# Agent Control System Logging (Production)
# ===========================================
# Production-level agent logging
AGENT_CONTROL_LOG_LEVEL=info
AGENT_SPAWN_LOGGING=true
AGENT_LIFECYCLE_TRACKING=true
AGENT_TELEMETRY_STREAMING=true
AGENT_STATUS_POLLING=true

# ===========================================
# Hybrid Architecture Logging (Production)
# ===========================================
# Minimal debug logging
HYBRID_CONTROL_DEBUG=false
TCP_MCP_DATA_PLANE_LOGGING=true
DOCKER_EXEC_CONTROL_PLANE_LOGGING=true
CROSS_CONTAINER_BRIDGE_LOGGING=true

# ===========================================
# Bots Orchestrator WebSocket (Production)
# ===========================================
# REQUIRED: Production orchestrator
BOTS_ORCHESTRATOR_URL=ws://agentic-workstation:3002/ws

# ===========================================
# Security Configuration (Production)
# ===========================================
# CRITICAL SECURITY: JWT Configuration
# - Generate cryptographically secure random secret (minimum 64 characters)
# - Never use example values
# - Rotate every 90 days
# - Use: openssl rand -base64 64
# REQUIRED
JWT_SECRET=${JWT_SECRET}
JWT_EXPIRATION=3600

# CRITICAL SECURITY: Session Configuration
# - Generate separate secret from JWT (minimum 64 characters)
# - Rotate every 90 days
# REQUIRED
SESSION_SECRET=${SESSION_SECRET}
SESSION_TIMEOUT=1800

# CRITICAL SECURITY: WebSocket Security
# - Enable authentication in production
# - Generate strong token (minimum 32 characters)
# REQUIRED
WS_AUTH_ENABLED=true
WS_AUTH_TOKEN=
WS_MAX_CONNECTIONS=100
WS_CONNECTION_TIMEOUT=300000
TCP_MAX_CONNECTIONS=50
TCP_CONNECTION_TIMEOUT=300000

# CRITICAL SECURITY: CORS Configuration
# - Restrict to production domains only
# - Never use wildcards (*)
# REQUIRED. A LAN-only host (VISIONCLAW_INGRESS=lan) must replace the public
# domain with its own origin, e.g. http://<host>:3001 (ADR-2119)
CORS_ALLOWED_ORIGINS=https://junkiejarvis.com
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization

# Rate Limiting - Production values
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ===========================================
# Input Validation Configuration (Production)
# ===========================================
# Strict limits for production security
MAX_REQUEST_SIZE=10485760
MAX_FIELD_SIZE=1048576
ALLOWED_FILE_TYPES=.jpg,.png,.pdf,.txt,.md
SANITIZE_HTML=true

# ===========================================
# Monitoring and Logging (Production)
# ===========================================
# Production-optimized logging
LOG_LEVEL=info
LOG_FORMAT=json
ENABLE_ACCESS_LOGS=true
ENABLE_ERROR_LOGS=true
LOG_RETENTION_DAYS=30
LOG_STRUCTURED_JSON=true

# ===========================================
# Performance Monitoring (Production)
# ===========================================
# Enable production performance tracking
PERFORMANCE_MONITORING=true
PERFORMANCE_TRACE_ENABLED=true
BOTTLENECK_DETECTION=true
LATENCY_TRACKING=true

# ===========================================
# Telemetry System (Production)
# ===========================================
# Production telemetry
TELEMETRY_ENABLED=true
TELEMETRY_LOG_LEVEL=info
TELEMETRY_METRICS_INTERVAL=5000
TELEMETRY_GPU_MONITORING=true
TELEMETRY_NETWORK_MONITORING=true

# ===========================================
# Network State Monitoring (Production)
# ===========================================
# Enable production network monitoring
NETWORK_STATE_MONITORING=true
CONNECTION_HEALTH_CHECKS=true
RETRY_OPERATION_LOGGING=true
CIRCUIT_BREAKER_LOGGING=true

# ===========================================
# Health Check (Production)
# ===========================================
# REQUIRED: Health check for load balancers
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PORT=9501
HEALTH_CHECK_PATH=/health

# ===========================================
# Resource Limits (Production)
# ===========================================
# Production resource constraints
MAX_MEMORY_MB=8192
MAX_CPU_CORES=8
MAX_WORKERS=8
MAX_CONNECTIONS=200

# ===========================================
# Backup Configuration (Production)
# ===========================================
# OPTIONAL: Automated backup settings
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=us-east-1

# ===========================================
# Alert Configuration (Production)
# ===========================================
# OPTIONAL: Production alerting
ALERT_ENABLED=true
ALERT_EMAIL=
ALERT_SLACK_WEBHOOK=
ALERT_ON_ERROR=true
ALERT_ON_HIGH_MEMORY=true
ALERT_ON_HIGH_CPU=true

# ===========================================
# Metrics Export (Production)
# ===========================================
# OPTIONAL: Metrics export to monitoring systems
METRICS_EXPORT_ENABLED=true
PROMETHEUS_PORT=9102
PROMETHEUS_PATH=/metrics
GRAFANA_ENABLED=true

# ===========================================
# Feature Flags (Production)
# ===========================================
# Disable experimental features in production
FEATURE_FLAG_EXPERIMENTAL=false
FEATURE_FLAG_BETA_FEATURES=false
FEATURE_FLAG_DEBUG_UI=false

# ===========================================
# SSL/TLS Configuration (Production)
# ===========================================
# CRITICAL SECURITY: SSL/TLS settings
# - Use valid certificates from trusted CA
# - Enable HSTS
# - Use TLS 1.3
# OPTIONAL (if terminating SSL at application level)
SSL_ENABLED=true
SSL_CERT_PATH=/app/certs/cert.pem
SSL_KEY_PATH=/app/certs/key.pem
SSL_CA_PATH=/app/certs/ca.pem
FORCE_HTTPS=true
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000

# ===========================================
# Container Orchestration (Production)
# ===========================================
# OPTIONAL: Kubernetes/Docker Swarm settings
ORCHESTRATION_PLATFORM=kubernetes
POD_NAME=
REPLICA_COUNT=3
SERVICE_DISCOVERY_ENABLED=true
