CLAUDE_FLOW_HOST=localhost
MCP_TCP_PORT=9500
MCP_TRANSPORT=tcp
MCP_RECONNECT_ATTEMPTS=5
MCP_RECONNECT_DELAY=500

# REQUIRED: Management API settings
