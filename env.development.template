HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PORT=9501
HEALTH_CHECK_PATH=/health

# ===========================================
# Hot Reload Configuration (Development)
# ===========================================
# OPTIONAL: Enable hot reload for faster development
HOT_RELOAD_ENABLED=true
WATCH_FILE_CHANGES=true
AUTO_RESTART_ON_CHANGE=true

# ===========================================
# Development Tools
# ===========================================
# OPTIONAL: Enable development tools and debugging endpoints
DEV_TOOLS_ENABLED=true
ENABLE_PROFILING=true
ENABLE_DEBUG_ENDPOINTS=true
MOCK_EXTERNAL_APIS=false

# ===========================================
# Resource Limits (Development)
# ===========================================
# Relaxed limits for development
MAX_MEMORY_MB=4096
MAX_CPU_CORES=4
MAX_WORKERS=4
MAX_CONNECTIONS=100

# ===========================================
# Feature Flags (Development)
# ===========================================
# Enable experimental features in development
FEATURE_FLAG_EXPERIMENTAL=true
FEATURE_FLAG_BETA_FEATURES=true
FEATURE_FLAG_DEBUG_UI=true

# ===========================================
# Live Memory Cloud (Development)
# ===========================================
# Live memory cloud (/api/memory-cloud*) — read-only RuVector sidecar access.
# libpq conninfo for ruvector-postgres; leave empty to disable (endpoints 503).
# Supply the real password only in your private .env, never here.
# Use the SELECT-only reader role provisioned by the sidecar's owner (agentbox);
# sessions also run with default_transaction_read_only=on.
# Quote the value: unquoted, it is cut at the first space.
# RUVECTOR_PG_CONNINFO="host=ruvector-postgres port=5432 dbname=ruvector user=ruvector_reader password=<secret>"
RUVECTOR_PG_CONNINFO=
# Total sampled entries (clamped 500..50000) and rebuild interval (min 60 s).
MEMORY_CLOUD_SAMPLE=30000
MEMORY_CLOUD_REFRESH_SECS=900
# Comma list never sampled nor searched; `prefix*` matches by prefix.
# Empty keeps the default (personal-context).
MEMORY_CLOUD_EXCLUDE_NAMESPACES=personal-context
# OpenAI-compatible embeddings endpoint; the model must match the sidecar (384-dim).
MEMORY_CLOUD_EMBED_URL=http://xinference:9997/v1
MEMORY_CLOUD_EMBED_MODEL=bge-small-en-v1.5
# POST /api/memory-cloud/query budget per pubkey per minute (1-600).
MEMORY_CLOUD_QUERY_PER_MINUTE=30
# Access: every /api/memory-cloud* endpoint needs a NIP-98-signed power user,
# even with VISIONCLAW_DEV_MODE=1 or RBAC_PUBLIC_READS=1. A dev operator adds
# their own hex pubkey to POWER_USER_PUBKEYS and signs requests as usual.
