[gd_resource type="StandardMaterial3D" load_steps=2 format=3 uid="uid://b3xrmatgemf1"]

[ext_resource type="Material" path="res://materials/node_halo.tres" id="1_halo"]

; Transparent twin of gem.tres for NodesFadedMulti: the nodes whose proximity /
; grab label is showing are packed here by render_store.rs with COLOR.a eased to
; LABEL_FADE_ALPHA (30 %). Alpha blend, no depth write (depth_draw_mode default =
; opaque only), so the Label3D sitting inside the sphere is never occluded by it.
; The opaque pass (gem.tres) is untouched — only the dozen labelled nodes pay for
; transparency.
[resource]
transparency = 1
vertex_color_use_as_albedo = true
albedo_color = Color(1, 1, 1, 1)
metallic = 0.18
roughness = 0.36
emission_enabled = true
emission = Color(0.5, 0.35, 0.8, 1)
emission_energy_multiplier = 0.08
rim_enabled = true
rim = 0.28
rim_tint = 0.4
next_pass = ExtResource("1_halo")
