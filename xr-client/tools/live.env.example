# Render-host launch configuration for tools/live.sh. Copy to live.env in the
# live directory (LIVE_DIR, by default the parent of the exported xr-client, so
# one file serves every export: e.g. ~/mce-xr/live.env) or point LIVE_ENV at it.
# It stays outside the exported tree and outside git: addresses are deployment
# configuration, not source. A variable already set in the environment wins.

# VisionClaw backend WebSocket base (graph /wss and presence /ws/presence are
# appended). Required.
XR_BACKEND_WS=ws://<backend-host>:4000

# Codescape, when it is reached through a different host or port than the
# backend (the client appends /codescape). Optional.
#XR_CODESCAPE_WS=ws://<codescape-host>:3001

# HTTP origin for REST writes when it is not the ws base with its scheme swapped.
# Optional.
#XR_BACKEND_HTTP=http://<backend-host>:4000

# Godot binary (the client runs 4.8-beta2). Optional when godot4/godot is on PATH.
#GODOT=/path/to/Godot_v4.8-beta2_linux.x86_64
